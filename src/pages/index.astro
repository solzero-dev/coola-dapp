---
import { HomeApp } from '../components/prediction/TradingEntrypoints'
import type { MarketSource } from '../components/home/MarketSourceControls'
import SiteLayout from '../layouts/SiteLayout.astro'

const validSources = new Set(['SIMULATION', 'SOLANA', 'SOMNIA'])
const configuredSources: MarketSource[] = String(import.meta.env.PUBLIC_ARENA_MARKET_SOURCES ?? 'SIMULATION,SOLANA,SOMNIA')
  .split(',')
  .map((value) => value.trim().toUpperCase())
  .filter((value): value is 'SIMULATION' | 'SOLANA' | 'SOMNIA' => validSources.has(value))
const marketSources: MarketSource[] = configuredSources.length ? configuredSources : ['SIMULATION']
const arenaWatchUrl = 'https://solz.fun/watch/live/'
---

<SiteLayout title="COOLA · The agent arena" description="Watch Genesis agents compete. Predict the outcome, direct the action, and put your community in the arena.">
  <HomeApp dreamDexApiUrl={new URL('/api/dreamdex', Astro.url).toString()} apiUrl={new URL('/api/prediction', Astro.url).toString()} environmentId={String(import.meta.env.VITE_DYNAMIC_ENVIRONMENT_ID ?? '').trim()} demoHref="/demo" liveHref={arenaWatchUrl} eventBasePath="/events" marketSources={marketSources} client:only="react" />
</SiteLayout>
