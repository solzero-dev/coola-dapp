---
import { PortfolioApp } from '../../../components/prediction/TradingEntrypoints'
import SiteLayout from '../../../layouts/SiteLayout.astro'

const chain = Astro.params.chain
const network = Astro.params.network
const address = Astro.params.address
const valid = (chain === 'solana' || chain === 'somnia') &&
  (network === 'devnet' || network === 'testnet' || network === 'mainnet') &&
  Boolean(address)

if (!valid) return Astro.redirect('/')

const profile = {
  chain: chain as 'solana' | 'somnia',
  network: network as 'devnet' | 'testnet' | 'mainnet',
  address: address!,
}

const apiUrl = new URL('/api/dreamdex', Astro.url).toString()
const environmentId = String(import.meta.env.VITE_DYNAMIC_ENVIRONMENT_ID ?? '').trim()
---
<SiteLayout title="Profile · COOLA" description="Public prediction profile and positions by wallet address.">
  <PortfolioApp matchApiUrl="/api/agent-arena" apiUrl={apiUrl} environmentId={environmentId} profile={profile} client:only="react" />
</SiteLayout>
