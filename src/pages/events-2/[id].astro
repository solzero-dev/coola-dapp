---
import { EventApp } from '../../components/prediction/TradingEntrypoints'
import SiteLayout from '../../layouts/SiteLayout.astro'
---

<SiteLayout title="Event community · COOLA" description="Join the sideline, follow the live match, and trade the outcome in the COOLA arena.">
  <EventApp apiUrl={new URL('/api/prediction', Astro.url).toString()} eventId={Astro.params.id ?? ''} initialOutcomeId={Astro.url.searchParams.get('outcome') ?? undefined} variant="community" environmentId={String(import.meta.env.VITE_DYNAMIC_ENVIRONMENT_ID ?? '').trim()} paths={{ home: '/', demo: '/demo', live: '/live', variants: { markets: '/events', community: '/events-2', agents: '/events-3' } }} client:only="react" />
</SiteLayout>
