# Public browser configuration. Required for wallet connection; safe to leave
# empty only when the wallet flow is intentionally disabled.
VITE_DYNAMIC_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
# Optional. An empty value falls back to simulation-only market controls.
PUBLIC_ARENA_MARKET_SOURCES=somnia

# Server-only DreamDEX demo configuration. Do not prefix these variables with
# PUBLIC_ or VITE_; Vercel reads them only inside Astro API routes.
# Required: an empty value makes DreamDEX server routes return an error.
DATABASE_URL=
# Required for sponsored DreamDEX market creation and the test faucet.
PVT_KEY=
# Required in principle; this default is the live authoritative SOLZ API.
SOLZ_GAME_API_ORIGIN=https://solz-elysia-production.up.railway.app
# Optional: empty values use the deployed Shannon demo defaults below.
DREAMDEX_OPERATOR_ID=22
DREAMDEX_VENUE_ID=0x6891b01528b646d3d0e273b7a56a751ccd9937f93c4f054a2a00404bb4fe6462
